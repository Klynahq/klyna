---
interface Props { locale?: string }
const { locale = 'en' } = Astro.props;
const prefix = ['es', 'fr', 'it'].includes(locale) ? `/${locale}` : '';
const copy: Record<string, { intro:string; products:string; support:string }> = {
  en: { intro:'Indie studio building open, modern tools for makers, creators, and growth-minded folks. Free where it can be. Honest where it matters.', products:'Products', support:'Support' },
  es: { intro:'Estudio independiente que crea herramientas modernas y abiertas para tiendas, creadores y equipos de crecimiento.', products:'Productos', support:'Ayuda' },
  fr: { intro:'Studio indépendant qui crée des outils modernes et ouverts pour les boutiques, créateurs et équipes de croissance.', products:'Produits', support:'Aide' },
  it: { intro:'Studio indipendente che crea strumenti moderni e aperti per negozi, creator e team di crescita.', products:'Prodotti', support:'Aiuto' },
};
const text = copy[locale] ?? copy.en!;
const year = new Date().getFullYear();
---

<footer class="border-t border-[color:var(--color-border)]/50 mt-32">
  <div class="max-w-7xl mx-auto px-6 py-12 grid gap-8 md:grid-cols-5">
    <div class="md:col-span-2">
      <div class="flex items-center gap-2 font-semibold text-lg">
        <span
          class="inline-block w-7 h-7 rounded-lg bg-gradient-to-br from-[color:var(--color-accent)] to-[#5b3df0]"
        ></span>
        <span>Klyna</span>
      </div>
      <p class="mt-3 text-[color:var(--color-text-muted)] text-sm max-w-md">
        {text.intro}
      </p>
    </div>

    <div>
      <p
        class="text-xs uppercase tracking-wider text-[color:var(--color-text-dim)] font-medium mb-3"
      >
        Studio
      </p>
      <ul class="space-y-2 text-sm">
        <li>
          <a href={`${prefix}/products`} class="text-[color:var(--color-text-muted)] hover:text-white">
            {text.products}
          </a>
        </li>
        <li>
          <a href="/downloads" class="text-[color:var(--color-text-muted)] hover:text-white">
            Downloads
          </a>
        </li>
        <li>
          <a href="/about" class="text-[color:var(--color-text-muted)] hover:text-white">About</a>
        </li>
        <li>
          <a href="/legal" class="text-[color:var(--color-text-muted)] hover:text-white">Legal</a>
        </li>
      </ul>
    </div>

    <div>
      <p
        class="text-xs uppercase tracking-wider text-[color:var(--color-text-dim)] font-medium mb-3"
      >
        {text.support}
      </p>
      <ul class="space-y-2 text-sm">
        <li>
          <a href="/help" class="text-[color:var(--color-text-muted)] hover:text-white">
            Help center
          </a>
        </li>
        <li>
          <a href="/faq" class="text-[color:var(--color-text-muted)] hover:text-white">FAQ</a>
        </li>
        <li>
          <a href="/contact" class="text-[color:var(--color-text-muted)] hover:text-white">
            Contact
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p
        class="text-xs uppercase tracking-wider text-[color:var(--color-text-dim)] font-medium mb-3"
      >
        Elsewhere
      </p>
      <ul class="space-y-2 text-sm">
        <li>
          <a
            href="https://github.com/klynahq"
            class="text-[color:var(--color-text-muted)] hover:text-white"
          >
            GitHub
          </a>
        </li>
        <li>
          <a
            href="https://x.com/klynahq"
            class="text-[color:var(--color-text-muted)] hover:text-white"
          >
            X / Twitter
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div
    class="border-t border-[color:var(--color-border)]/50 py-6 text-center text-xs text-[color:var(--color-text-dim)]"
  >
    © {year} Klyna. Built with care.
  </div>
</footer>
