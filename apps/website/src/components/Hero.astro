---
import { brand } from '@klyna/ui';
---

<section class="relative overflow-hidden">
  <div class="grid-bg absolute inset-0 opacity-40 pointer-events-none"></div>
  <div class="relative max-w-7xl mx-auto px-6 pt-24 pb-20 md:pt-32 md:pb-28">
    <div class="max-w-3xl">
      <div
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-[color:var(--color-accent-muted)] text-[color:var(--color-accent)] border border-[color:var(--color-accent)]/30 mb-6"
      >
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-[color:var(--color-accent)] animate-pulse"></span>
        Studio in build. First product ships soon.
      </div>

      <h1
        class="text-5xl md:text-7xl font-bold tracking-tight leading-[1.05] mb-6 bg-gradient-to-br from-white via-white to-[color:var(--color-text-muted)] bg-clip-text text-transparent"
      >
        {brand.tagline}
      </h1>

      <p class="text-lg md:text-xl text-[color:var(--color-text-muted)] max-w-2xl leading-relaxed mb-10">
        Klyna is an indie studio building modern, open-source SEO and growth tools.
        Honest pricing, real impact, zero dark patterns. The first three products ship as a
        WordPress plugin, a Shopify app, and a browser extension — all under one roof.
      </p>

      <div class="flex flex-wrap items-center gap-3">
        <a
          href="/products"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-[color:var(--color-accent)] hover:bg-[color:var(--color-accent-hover)] text-white font-medium transition-colors shadow-[0_8px_32px_-8px_var(--color-accent)]"
        >
          See what's coming
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="https://github.com/klynahq"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-lg border border-[color:var(--color-border)] hover:border-[color:var(--color-accent)] text-[color:var(--color-text-muted)] hover:text-white transition-colors"
        >
          Follow on GitHub
        </a>
      </div>
    </div>
  </div>
</section>
