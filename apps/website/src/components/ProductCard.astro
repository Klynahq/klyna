---
import { type Product, statusLabel, surfaceLabel } from '@klyna/utils';

interface Props {
  product: Product;
  /** Show the download CTA (used on the /downloads team page) */
  showDownload?: boolean;
}

const { product, showDownload = false } = Astro.props;

const statusColor: Record<string, string> = {
  live: 'text-[color:var(--color-success)] bg-[color:var(--color-success)]/10 border-[color:var(--color-success)]/30',
  beta: 'text-[color:var(--color-warning)] bg-[color:var(--color-warning)]/10 border-[color:var(--color-warning)]/30',
  soon: 'text-[color:var(--color-accent)] bg-[color:var(--color-accent-muted)] border-[color:var(--color-accent)]/30',
  planning: 'text-[color:var(--color-text-muted)] bg-white/5 border-[color:var(--color-border)]',
};

const hasAppStoreLink = !!product.appStoreUrl;
const hasDownload = showDownload && !!product.downloadUrl && !hasAppStoreLink;
const hasProductLink = !!product.href;
---

<article
  class="group relative rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-6 hover:border-[color:var(--color-accent)]/50 transition-colors flex flex-col"
>
  <div class="flex items-start justify-between mb-4 gap-3">
    <div class="text-xs font-medium text-[color:var(--color-text-dim)] uppercase tracking-wider">
      {surfaceLabel(product.surface)}
    </div>
    <span class={`shrink-0 text-[10px] uppercase tracking-wider font-semibold px-2 py-1 rounded-full border ${statusColor[product.status]}`}>
      {statusLabel(product.status)}
    </span>
  </div>

  <h3 class="text-xl font-semibold mb-1 group-hover:text-[color:var(--color-accent)] transition-colors">
    {product.name}
  </h3>
  <p class="text-sm text-[color:var(--color-text)] font-medium mb-3">{product.tagline}</p>
  <p class="text-sm text-[color:var(--color-text-muted)] leading-relaxed flex-1">{product.description}</p>

  {hasDownload && (
    <div class="mt-5 pt-5 border-t border-[color:var(--color-border)]/60">
      {product.installNote && (
        <p class="text-[11px] font-mono text-[color:var(--color-text-dim)] mb-3 truncate" title={product.installNote}>
          $ {product.installNote}
        </p>
      )}
      <a
        href={product.downloadUrl}
        download
        class="inline-flex items-center gap-2 w-full justify-center px-4 py-2.5 rounded-lg bg-[color:var(--color-accent)] hover:bg-[color:var(--color-accent-hover)] text-white text-sm font-semibold transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        Download .zip
      </a>
    </div>
  )}

  {showDownload && !product.downloadUrl && !hasAppStoreLink && (
    <div class="mt-5 pt-5 border-t border-[color:var(--color-border)]/60">
      <span class="inline-flex items-center gap-1.5 text-xs text-[color:var(--color-text-dim)]">
        <span class="w-1.5 h-1.5 rounded-full bg-[color:var(--color-text-dim)] animate-pulse"></span>
        In development
      </span>
    </div>
  )}

  {(hasAppStoreLink || hasProductLink) && !hasDownload && (
    <div class="mt-5 pt-5 border-t border-[color:var(--color-border)]/60 flex flex-wrap items-center gap-3">
      {hasAppStoreLink && (
        <a
          href={product.appStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-10 items-center justify-center px-4 py-2 rounded-lg bg-[color:var(--color-accent)] hover:bg-[color:var(--color-accent-hover)] text-white text-sm font-semibold transition-colors"
        >
          Install on Shopify
        </a>
      )}
      {hasProductLink && (
        <a
          href={product.href}
          class="inline-flex min-h-10 items-center gap-2 px-1 text-sm font-semibold text-[color:var(--color-accent)] hover:text-[color:var(--color-accent-hover)] transition-colors"
        >
          {hasAppStoreLink ? 'Read the guide' : 'Learn more'}
          <span aria-hidden="true">→</span>
        </a>
      )}
    </div>
  )}
</article>
