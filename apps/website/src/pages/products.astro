---
import { products } from '@klyna/utils';
import ProductCard from '../components/ProductCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const shopifyApps = products.filter((p) => p.surface === 'shopify');
const wpPlugins = products.filter((p) => p.surface === 'wordpress');
const themes = products.filter((p) => p.surface === 'theme');
const other = products.filter((p) => !['shopify', 'wordpress', 'theme'].includes(p.surface));
---

<BaseLayout
  title="Products — Klyna"
  description="The full Klyna lineup of Shopify apps, WordPress plugins, themes, and browser tools for SEO, storefront operations, and growth."
>
  <!-- Hero -->
  <section class="max-w-7xl mx-auto px-6 pt-20 pb-12">
    <div class="max-w-2xl">
      <div class="text-xs font-semibold uppercase tracking-wider text-[color:var(--color-accent)] mb-3">
        The lineup
      </div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">Products</h1>
      <p class="text-[color:var(--color-text-muted)] leading-relaxed max-w-xl">
        Every Klyna tool runs on the same shared engine — brand-consistent, no bloat,
        no paid APIs in the default stack. The lineup spans Shopify apps, WordPress plugins,
        and themes for the whole growth stack.
      </p>
    </div>

    <!-- Team download CTA -->
    <div class="mt-8 inline-flex items-center gap-3 px-5 py-3 rounded-xl border border-[color:var(--color-warning)]/40 bg-[color:var(--color-warning)]/5">
      <span class="w-2 h-2 rounded-full bg-[color:var(--color-warning)] animate-pulse"></span>
      <span class="text-sm text-[color:var(--color-text-muted)]">Team member?</span>
      <a
        href="/downloads"
        class="text-sm font-semibold text-[color:var(--color-warning)] hover:underline"
      >
        Download all beta builds →
      </a>
    </div>
  </section>


  <section class="max-w-7xl mx-auto px-6 pb-12" data-strict-research-intent>
    <div class="rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-6 md:p-8">
      <div class="text-xs font-semibold uppercase tracking-wider text-[color:var(--color-accent)] mb-3">
        Search intent to satisfy
      </div>
      <h2 class="text-2xl font-bold tracking-tight mb-3">Help product-intent visitors choose the right Klyna tool.</h2>
      <div class="grid gap-4 md:grid-cols-3 text-sm text-[color:var(--color-text-muted)] leading-relaxed">
        <p><strong class="text-white">Searcher job:</strong> Compare Klyna Shopify apps, WordPress plugins, themes, and extension workflows from one product index.</p>
        <p><strong class="text-white">Competitor gap:</strong> App directories often hide workflow differences; this page groups tools by surface so teams can map a problem to the right beta product.</p>
        <p><strong class="text-white">Next action:</strong> Start with the relevant product card, then use <a href="/downloads" class="text-[color:var(--color-accent)] hover:underline">Downloads</a>, <a href="/help" class="text-[color:var(--color-accent)] hover:underline">Help</a>, or <a href="/contact" class="text-[color:var(--color-accent)] hover:underline">Contact</a> for install support.</p>
      </div>
    </div>
  </section>


  <!-- Shopify Apps -->
  <section class="max-w-7xl mx-auto px-6 pb-14">
    <div class="flex items-end justify-between mb-6">
      <div>
        <div class="text-xs font-semibold uppercase tracking-wider text-[color:var(--color-accent)] mb-2">Shopify Apps</div>
        <h2 class="text-2xl font-bold tracking-tight">{shopifyApps.length} apps</h2>
      </div>
    </div>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {shopifyApps.map(p => <ProductCard product={p} />)}
    </div>
  </section>

  <!-- WordPress Plugins -->
  <section class="max-w-7xl mx-auto px-6 pb-14">
    <div class="flex items-end justify-between mb-6">
      <div>
        <div class="text-xs font-semibold uppercase tracking-wider text-[color:var(--color-success)] mb-2">WordPress Plugins</div>
        <h2 class="text-2xl font-bold tracking-tight">{wpPlugins.length} plugins</h2>
      </div>
    </div>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {wpPlugins.map(p => <ProductCard product={p} />)}
    </div>
  </section>

  <!-- Themes -->
  {themes.length > 0 && (
    <section class="max-w-7xl mx-auto px-6 pb-14">
      <div class="mb-6">
        <div class="text-xs font-semibold uppercase tracking-wider text-[color:var(--color-text-dim)] mb-2">Shopify Themes</div>
        <h2 class="text-2xl font-bold tracking-tight">{themes.length} themes</h2>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {themes.map(p => <ProductCard product={p} />)}
      </div>
    </section>
  )}

  <!-- Extension + other -->
  {other.length > 0 && (
    <section class="max-w-7xl mx-auto px-6 pb-14">
      <div class="mb-6">
        <div class="text-xs font-semibold uppercase tracking-wider text-[color:var(--color-text-dim)] mb-2">Other tools</div>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {other.map(p => <ProductCard product={p} />)}
      </div>
    </section>
  )}

  <!-- Bottom note -->
  <section class="max-w-3xl mx-auto px-6 pb-24">
    <div class="rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-8">
      <h2 class="text-xl font-semibold mb-2">Built on one engine.</h2>
      <p class="text-sm text-[color:var(--color-text-muted)] leading-relaxed">
        Every product in the Klyna fleet shares the same TypeScript core for SEO analysis,
        schema generation, and link suggestions — so improvements compound across the whole lineup.
        Each app and plugin is self-contained: no paid SaaS, no forced accounts, no dark patterns.
      </p>
    </div>
  </section>
</BaseLayout>
