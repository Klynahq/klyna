---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllTags, getPostsByTag, formatDate } from '../../../utils/blog.ts';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map(({ tag, slug }) => ({
    params: { tag: slug },
    props: { tagLabel: tag },
  }));
}

const { tag } = Astro.params;
const { tagLabel } = Astro.props;
const posts = await getPostsByTag(tag);
---

<BaseLayout
  title={`#${tagLabel} — Klyna Blog`}
  description={`All Klyna blog posts tagged ${tagLabel}.`}
>
  <section class="max-w-4xl mx-auto px-6 pt-20 pb-12">
    <nav class="mb-6 text-sm text-[color:var(--color-text-dim)]">
      <a href="/blog" class="hover:text-white">← All posts</a>
    </nav>
    <div class="text-xs font-semibold uppercase tracking-wider text-[color:var(--color-accent)] mb-3">
      Tag
    </div>
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">
      #{tagLabel}
    </h1>
    <p class="text-[color:var(--color-text-muted)]">
      {posts.length} {posts.length === 1 ? 'post' : 'posts'} tagged
      <code class="text-[color:var(--color-text)]">{tagLabel}</code>.
    </p>
  </section>

  <section class="max-w-4xl mx-auto px-6 pb-24">
    <ul class="divide-y divide-[color:var(--color-border)]/50 border-y border-[color:var(--color-border)]/50">
      {
        posts.map((post) => (
          <li>
            <a
              href={`/blog/${post.id}`}
              class="group block py-6 px-4 -mx-4 rounded-xl hover:bg-white/5 transition-colors"
            >
              <div class="flex items-center gap-3 mb-2 text-xs">
                <time class="text-[color:var(--color-text-dim)] font-medium">
                  {formatDate(post.data.publishedAt)}
                </time>
                <span class="text-[color:var(--color-text-dim)]">·</span>
                <span class="text-[color:var(--color-accent)] font-medium uppercase tracking-wider">
                  {post.data.category}
                </span>
              </div>
              <h2 class="text-xl md:text-2xl font-semibold mb-2 group-hover:text-[color:var(--color-accent)] transition-colors">
                {post.data.title}
              </h2>
              <p class="text-[color:var(--color-text-muted)] leading-relaxed">
                {post.data.description}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
