---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '@klyna/utils';

const shopifyApps  = products.filter(p => p.surface === 'shopify'   && p.downloadUrl);
const wpPlugins    = products.filter(p => p.surface === 'wordpress'  && p.downloadUrl);
const comingSoon   = products.filter(p => !p.downloadUrl && p.status !== 'planning');
---

<BaseLayout
  title="Downloads — Klyna Team"
  description="Internal downloads hub for the Klyna team. All beta builds of every Shopify app, WordPress plugin and theme — ready to test."
  noIndex={true}
>
  <!-- ── Hero ──────────────────────────────────────────────────────────────── -->
  <section class="max-w-7xl mx-auto px-6 pt-20 pb-10">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-[color:var(--color-warning)]/40 bg-[color:var(--color-warning)]/10 text-[color:var(--color-warning)] text-xs font-semibold uppercase tracking-wider mb-6">
      <span class="w-1.5 h-1.5 rounded-full bg-[color:var(--color-warning)] animate-pulse"></span>
      Internal — team only
    </div>

    <div class="max-w-3xl">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">
        Fleet downloads.
      </h1>
      <p class="text-[color:var(--color-text-muted)] text-lg leading-relaxed">
        Every beta build of the Klyna product fleet. Download, install, break things, report back.
        These are real, complete builds — not stubs. Each ships source code, a branded logo, and
        install instructions.
      </p>
    </div>

    <!-- Stats bar -->
    <div class="mt-10 flex flex-wrap gap-6">
      {[
        { n: shopifyApps.length,  label: 'Shopify apps',       color: 'var(--color-accent)' },
        { n: wpPlugins.length,    label: 'WordPress plugins',   color: 'var(--color-success)' },
        { n: comingSoon.length,   label: 'In development',      color: 'var(--color-text-dim)' },
      ].map(s => (
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-bold" style={`color:${s.color}`}>{s.n}</span>
          <span class="text-sm text-[color:var(--color-text-muted)]">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ── Shopify Apps ───────────────────────────────────────────────────────── -->
  <section class="max-w-7xl mx-auto px-6 pb-16">
    <div class="flex items-end justify-between mb-6">
      <div>
        <div class="text-xs font-semibold uppercase tracking-wider text-[color:var(--color-accent)] mb-2">
          Shopify Apps
        </div>
        <h2 class="text-2xl font-bold tracking-tight">10 Shopify apps</h2>
      </div>
      <div class="hidden md:block text-sm text-[color:var(--color-text-dim)] max-w-xs text-right">
        Remix + Polaris + Prisma. Requires a Shopify Partner account &amp; dev store to run.
      </div>
    </div>

    <!-- Install guide callout -->
    <div class="mb-6 rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-4 flex gap-4 items-start">
      <div class="shrink-0 w-8 h-8 rounded-lg bg-[color:var(--color-accent)]/15 flex items-center justify-center mt-0.5">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      </div>
      <div>
        <p class="text-sm font-medium text-[color:var(--color-text)] mb-1">How to run a Shopify app locally</p>
        <ol class="text-sm text-[color:var(--color-text-muted)] space-y-0.5 list-decimal list-inside">
          <li>Unzip the download into any folder</li>
          <li>Run <code class="font-mono text-xs bg-white/5 px-1.5 py-0.5 rounded">pnpm install</code></li>
          <li>Run <code class="font-mono text-xs bg-white/5 px-1.5 py-0.5 rounded">shopify app config link</code> — binds your Partner app client_id</li>
          <li>Run <code class="font-mono text-xs bg-white/5 px-1.5 py-0.5 rounded">pnpm dev</code> — opens the embedded app on your dev store via a tunnel</li>
        </ol>
        <p class="mt-1.5 text-xs text-[color:var(--color-text-dim)]">Needs: Node 20+, pnpm, Shopify CLI 3+, a Partner account, and a dev store.</p>
      </div>
    </div>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {shopifyApps.map(p => <ProductCard product={p} showDownload={true} />)}
    </div>
  </section>

  <!-- ── WordPress Plugins ─────────────────────────────────────────────────── -->
  <section class="max-w-7xl mx-auto px-6 pb-16">
    <div class="flex items-end justify-between mb-6">
      <div>
        <div class="text-xs font-semibold uppercase tracking-wider text-[color:var(--color-success)] mb-2">
          WordPress Plugins
        </div>
        <h2 class="text-2xl font-bold tracking-tight">9 WordPress plugins</h2>
      </div>
      <div class="hidden md:block text-sm text-[color:var(--color-text-dim)] max-w-xs text-right">
        Pure PHP 8+. Each has a unique namespace so all 9 can run on the same site.
      </div>
    </div>

    <!-- Install guide callout -->
    <div class="mb-6 rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-4 flex gap-4 items-start">
      <div class="shrink-0 w-8 h-8 rounded-lg bg-[color:var(--color-success)]/15 flex items-center justify-center mt-0.5">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      </div>
      <div>
        <p class="text-sm font-medium text-[color:var(--color-text)] mb-1">How to install a WordPress plugin</p>
        <ol class="text-sm text-[color:var(--color-text-muted)] space-y-0.5 list-decimal list-inside">
          <li>In WP Admin go to <strong>Plugins → Add New → Upload Plugin</strong></li>
          <li>Upload the <code class="font-mono text-xs bg-white/5 px-1.5 py-0.5 rounded">.zip</code> file and click Install Now</li>
          <li>Click <strong>Activate Plugin</strong></li>
          <li>Find the plugin's menu item in the WP Admin sidebar</li>
        </ol>
        <p class="mt-1.5 text-xs text-[color:var(--color-text-dim)]">Needs: WordPress 6.4+, PHP 8.0+. Each plugin is self-contained — no build step, no composer.</p>
      </div>
    </div>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {wpPlugins.map(p => <ProductCard product={p} showDownload={true} />)}
    </div>
  </section>

  <!-- ── Coming soon ────────────────────────────────────────────────────────── -->
  {comingSoon.length > 0 && (
    <section class="max-w-7xl mx-auto px-6 pb-20">
      <div class="mb-6">
        <div class="text-xs font-semibold uppercase tracking-wider text-[color:var(--color-text-dim)] mb-2">
          Still building
        </div>
        <h2 class="text-2xl font-bold tracking-tight">In development</h2>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {comingSoon.map(p => <ProductCard product={p} showDownload={true} />)}
      </div>
    </section>
  )}

  <!-- ── Footer note ────────────────────────────────────────────────────────── -->
  <section class="max-w-3xl mx-auto px-6 pb-24">
    <div class="rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-8">
      <h2 class="text-lg font-semibold mb-2">Reporting issues</h2>
      <p class="text-sm text-[color:var(--color-text-muted)] leading-relaxed">
        Found a bug, a missing feature, or something off-brand? Open an issue in the GitHub repo
        or drop a message in Slack. All builds are on their own <code class="font-mono text-xs bg-white/5 px-1.5 py-0.5 rounded">feat/*</code> branch —
        fixes go there, not to <code class="font-mono text-xs bg-white/5 px-1.5 py-0.5 rounded">main</code>.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href="https://github.com/klynahq/klyna"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-[color:var(--color-border)] hover:border-[color:var(--color-accent)] text-sm text-[color:var(--color-text-muted)] hover:text-white transition-colors"
        >
          GitHub repo →
        </a>
        <a
          href="/products"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-[color:var(--color-border)] hover:border-[color:var(--color-accent)] text-sm text-[color:var(--color-text-muted)] hover:text-white transition-colors"
        >
          Public products page →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
