---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found — Klyna" description="That page doesn't exist (yet).">
  <section class="max-w-2xl mx-auto px-6 pt-32 pb-24 text-center">
    <div class="text-7xl md:text-8xl font-bold tracking-tight mb-4 bg-gradient-to-br from-white to-[color:var(--color-text-muted)] bg-clip-text text-transparent">
      404
    </div>
    <h1 class="text-2xl md:text-3xl font-semibold mb-3">Page not found.</h1>
    <p class="text-[color:var(--color-text-muted)] mb-8">
      The link you followed may be broken, or the page may not have shipped yet.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-[color:var(--color-accent)] hover:bg-[color:var(--color-accent-hover)] text-white font-medium transition-colors"
    >
      Back to home
    </a>
  </section>
</BaseLayout>
