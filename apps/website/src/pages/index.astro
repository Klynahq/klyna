---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProductCard from '../components/ProductCard.astro';
import FeatureList from '../components/FeatureList.astro';
import { products } from '@klyna/utils';
import { getPublishedPosts, formatDate } from '../utils/blog.ts';

const latestPosts = (await getPublishedPosts()).slice(0, 3);
// Show the first 3 beta Shopify apps as hero products on the homepage
const heroProducts = products.filter(p => p.status === 'beta' && p.surface === 'shopify').slice(0, 3);
---

<BaseLayout>
  <Hero />

  <section class="max-w-7xl mx-auto px-6 pb-12" data-strict-research-intent>
    <div class="rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-6 md:p-8">
      <div class="text-xs font-semibold uppercase tracking-wider text-[color:var(--color-accent)] mb-3">
        Search intent to satisfy
      </div>
      <h2 class="text-2xl font-bold tracking-tight mb-3">When someone searches Klyna, show the product path quickly.</h2>
      <div class="grid gap-4 md:grid-cols-3 text-sm text-[color:var(--color-text-muted)] leading-relaxed">
        <p><strong class="text-white">Searcher job:</strong> Understand what Klyna is, which ecommerce or WordPress workflow it helps with, and where to try the current beta tools.</p>
        <p><strong class="text-white">Competitor gap:</strong> Tool brands often split downloads, docs, and product positioning across disconnected pages; this homepage keeps the fleet, blog proof, and next action close together.</p>
        <p><strong class="text-white">Next action:</strong> Review <a href="/products" class="text-[color:var(--color-accent)] hover:underline">Products</a>, use <a href="/help" class="text-[color:var(--color-accent)] hover:underline">Help</a>, or open <a href="/downloads" class="text-[color:var(--color-accent)] hover:underline">Downloads</a> when a beta build is ready for testing.</p>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-6 pb-12">
    <div class="flex items-end justify-between mb-8">
      <div>
        <div class="text-xs font-semibold uppercase tracking-wider text-[color:var(--color-accent)] mb-2">
          The lineup
        </div>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">22-product fleet — now in beta.</h2>
      </div>
      <a
        href="/products"
        class="hidden md:inline-flex text-sm text-[color:var(--color-text-muted)] hover:text-white"
      >
        See all products →
      </a>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      {heroProducts.map((p) => <ProductCard product={p} />)}
    </div>

    <div class="mt-5 flex items-center gap-4">
      <a href="/products" class="text-sm text-[color:var(--color-text-muted)] hover:text-white transition-colors">
        See all 22 products →
      </a>
      <span class="text-[color:var(--color-border)]">·</span>
      <a href="/downloads" class="text-sm text-[color:var(--color-warning)] hover:underline">
        Team downloads →
      </a>
    </div>
  </section>

  <FeatureList />

  {
    latestPosts.length > 0 && (
      <section class="max-w-7xl mx-auto px-6 py-20">
        <div class="flex items-end justify-between mb-8">
          <div>
            <div class="text-xs font-semibold uppercase tracking-wider text-[color:var(--color-accent)] mb-2">
              From the blog
            </div>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
              Notes on growing organically.
            </h2>
          </div>
          <a
            href="/blog"
            class="hidden md:inline-flex text-sm text-[color:var(--color-text-muted)] hover:text-white"
          >
            All posts →
          </a>
        </div>

        <div class="grid gap-4 md:grid-cols-3">
          {latestPosts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="group block p-6 rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] hover:border-[color:var(--color-accent)]/50 transition-colors"
            >
              <div class="flex items-center gap-2 mb-3 text-xs">
                <span class="text-[color:var(--color-accent)] font-semibold uppercase tracking-wider">
                  {post.data.category}
                </span>
                <span class="text-[color:var(--color-text-dim)]">·</span>
                <time class="text-[color:var(--color-text-dim)]">
                  {formatDate(post.data.publishedAt)}
                </time>
              </div>
              <h3 class="text-lg font-semibold mb-2 group-hover:text-[color:var(--color-accent)] transition-colors">
                {post.data.title}
              </h3>
              <p class="text-sm text-[color:var(--color-text-muted)] line-clamp-3 leading-relaxed">
                {post.data.description}
              </p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="max-w-3xl mx-auto px-6 py-20 text-center">
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4">
      Get notified when the first product ships.
    </h2>
    <p class="text-[color:var(--color-text-muted)] mb-8">
      No spam, no drip campaigns. One email when Klyna Inspector hits the Chrome Web Store.
    </p>
    <a
      href="https://github.com/klynahq"
      class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-[color:var(--color-accent-solid)] hover:bg-[color:var(--color-accent-solid-hover)] text-white font-medium transition-colors"
    >
      Watch the GitHub org
      <span aria-hidden="true">→</span>
    </a>
  </section>
</BaseLayout>
