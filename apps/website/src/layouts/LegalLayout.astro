---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  heading: string;
  kicker?: string;
  effective?: string;
  updated?: string;
}

const {
  title,
  description,
  heading,
  kicker = 'Legal',
  effective = '2026-06-12',
  updated = '2026-06-12',
} = Astro.props;
---

<BaseLayout title={`${title} — Klyna`} description={description}>
  <article class="max-w-3xl mx-auto px-6 pt-20 pb-24">
    <a
      href="/legal"
      class="inline-block text-xs text-[color:var(--color-text-dim)] hover:text-[color:var(--color-accent)] mb-6"
    >
      &larr; Back to legal
    </a>

    <div
      class="text-xs font-semibold uppercase tracking-wider text-[color:var(--color-accent)] mb-3"
    >
      {kicker}
    </div>
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">{heading}</h1>

    <div class="flex flex-wrap gap-x-6 gap-y-1 text-xs text-[color:var(--color-text-dim)] mb-10">
      <span>Effective: {effective}</span>
      <span>Last updated: {updated}</span>
    </div>

    <div
      class="legal-prose space-y-5 text-[color:var(--color-text-muted)] leading-relaxed text-base"
    >
      <slot />
    </div>

    <hr class="my-12 border-[color:var(--color-border)]" />

    <p class="text-sm text-[color:var(--color-text-dim)]">
      Questions? Email
      <a
        href="mailto:hello@klyna.dev"
        class="text-[color:var(--color-accent)] hover:underline"
        >hello@klyna.dev</a
      >. Security reports go to
      <a
        href="mailto:security@klyna.dev"
        class="text-[color:var(--color-accent)] hover:underline"
        >security@klyna.dev</a
      >.
    </p>
  </article>
</BaseLayout>

<style is:global>
  .legal-prose h2 {
    color: var(--color-text);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
  }
  .legal-prose h3 {
    color: var(--color-text);
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .legal-prose a {
    color: var(--color-accent);
  }
  .legal-prose a:hover {
    text-decoration: underline;
  }
  .legal-prose ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .legal-prose ul li {
    margin-bottom: 0.4rem;
  }
  .legal-prose code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 0.05rem 0.35rem;
    border-radius: 4px;
  }
  .legal-prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    margin: 0.5rem 0;
  }
  .legal-prose th,
  .legal-prose td {
    border: 1px solid var(--color-border);
    padding: 0.5rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }
  .legal-prose th {
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: 600;
  }
</style>
