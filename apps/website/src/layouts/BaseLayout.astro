---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import SiteSchema from '../components/seo/SiteSchema.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  noIndex?: boolean;
}

const {
  title = 'Klyna — Tools that help your work get found.',
  description = 'Klyna builds modern SEO and growth tools for makers, creators, Shopify stores, WordPress sites, and browser workflows.',
  canonical,
  ogType = 'website',
  ogImage = '/favicon.svg',
  ogImageAlt,
  noIndex = false,
} = Astro.props;

const canonicalPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '');
const canonicalURL = canonical ?? new URL(canonicalPath, Astro.site).toString();
const fullOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.site).toString();

function fitMeta(value: string, maxLength: number): string {
  if (value.length <= maxLength) return value;

  const unbranded = value.replace(/\s+[—-]\s+Klyna(?: Blog)?$/, '');
  if (unbranded.length <= maxLength) return unbranded;

  const candidate = unbranded.slice(0, maxLength - 3);
  const lastSpace = candidate.lastIndexOf(' ');
  const cutAt = lastSpace >= maxLength - 18 ? lastSpace : candidate.length;
  return `${candidate.slice(0, cutAt).replace(/[,:;—-]+$/, '')}...`;
}

const metaTitle = fitMeta(title, 60);
const metaDescription = fitMeta(description, 155);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalURL} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={fullOgImage} />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta property="og:site_name" content="Klyna" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={fullOgImage} />
    {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}

    <meta name="theme-color" content="#0b0b0f" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Klyna Blog"
      href="/rss.xml"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <SiteSchema />
    <slot name="head" />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
