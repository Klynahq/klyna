{
  "name": "shopify-bundles",
  "version": "0.1.0",
  "private": true,
  "description": "Tools that help your work get found.",
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "vercel-build": "pnpm exec prisma db execute --schema prisma/schema.prisma --file prisma/migrations/20260717000000_add_shop_plan/migration.sql && pnpm exec prisma db execute --schema prisma/schema.prisma --file prisma/migrations/20260731000000_expiring_offline_tokens/migration.sql && pnpm exec prisma db execute --schema prisma/schema.prisma --file prisma/migrations/20260731010000_track_shopify_discounts/migration.sql && pnpm exec prisma generate && pnpm exec remix vite:build",
    "dev": "shopify app dev",
    "start": "remix-serve ./build/server/index.js",
    "config:link": "shopify app config link",
    "config:use": "shopify app config use",
    "deploy": "shopify app deploy",
    "generate": "shopify app generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "setup": "pnpm prisma:generate && pnpm prisma:migrate"
  },
  "dependencies": {
    "@klyna/ui": "workspace:*",
    "@prisma/client": "^6.0.0",
    "@remix-run/node": "^2.15.0",
    "@remix-run/react": "^2.15.0",
    "@remix-run/serve": "^2.15.0",
    "@shopify/app-bridge-react": "^4.2.12",
    "@shopify/polaris": "^13.9.0",
    "@shopify/polaris-icons": "^9.3.1",
    "@shopify/shopify-app-remix": "^4.2.1",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.1",
    "isbot": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.15.0",
    "@shopify/cli": "^3.71.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "prisma": "^6.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.0",
    "vite-tsconfig-paths": "^5.1.0"
  },
  "engines": {
    "node": "22.x"
  }
}
