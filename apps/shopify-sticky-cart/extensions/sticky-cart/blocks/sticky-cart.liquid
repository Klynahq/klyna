{%- comment -%}
  Klyna Sticky Cart — app embed block.

  Renders only on product pages. The bar's data (variants, price, image) comes
  from the Liquid `product` object; behavior + styling come from the merchant's
  app settings, which are loaded live from the App Proxy and fall back to the
  theme-editor settings below if the proxy is unreachable.
{%- endcomment -%}

{%- if template.name == 'product' and product -%}
  {%- assign first_available = product.selected_or_first_available_variant -%}

  <script type="application/json" data-klyna-sticky-cart-product>
    {
      "id": {{ product.id | json }},
      "title": {{ product.title | json }},
      "handle": {{ product.handle | json }},
      "featuredImage": {{ product.featured_image | image_url: width: 120 | json }},
      "url": {{ product.url | json }},
      "optionNames": {{ product.options | json }},
      "variants": [
        {%- for v in product.variants -%}
          {
            "id": {{ v.id | json }},
            "title": {{ v.title | json }},
            "available": {{ v.available | json }},
            "price": {{ v.price | json }},
            "options": {{ v.options | json }},
            "image": {{ v.image | default: product.featured_image | image_url: width: 120 | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>

  <div
    id="klyna-sticky-cart"
    class="klyna-sc"
    data-klyna-sticky-cart
    data-position="{{ block.settings.position | default: 'bottom' }}"
    data-show-after-scroll="{{ block.settings.show_after_scroll }}"
    data-show-image="{{ block.settings.show_image }}"
    data-show-price="{{ block.settings.show_price }}"
    data-show-variants="{{ block.settings.show_variants }}"
    data-show-quantity="{{ block.settings.show_quantity }}"
    data-cta-label="{{ block.settings.cta_label | escape }}"
    data-cta-color="{{ block.settings.cta_color }}"
    data-cta-text-color="{{ block.settings.cta_text_color }}"
    data-quickbuy="{{ block.settings.quick_buy }}"
    data-quickbuy-label="{{ block.settings.quick_buy_label | escape }}"
    data-freeship="{{ block.settings.free_ship }}"
    data-freeship-threshold="{{ block.settings.free_ship_threshold }}"
    data-freeship-color="{{ block.settings.free_ship_color }}"
    data-freeship-message="{{ block.settings.free_ship_message | escape }}"
    data-freeship-success="{{ block.settings.free_ship_success | escape }}"
    data-currency="{{ cart.currency.iso_code }}"
    data-money-format="{{ shop.money_format | escape }}"
    data-proxy="/apps/sticky-cart"
    data-cart-total="{{ cart.total_price }}"
    hidden
  >
    <div class="klyna-sc__banner" data-klyna-sc-recover hidden></div>
    <div class="klyna-sc__inner" data-klyna-sc-inner></div>
  </div>

  {{ 'sticky-cart.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'sticky-cart.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Klyna Sticky Cart",
  "target": "body",
  "settings": [
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Bar position",
      "options": [
        { "value": "bottom", "label": "Bottom of screen" },
        { "value": "top", "label": "Top, under header" }
      ],
      "default": "bottom"
    },
    {
      "type": "checkbox",
      "id": "show_after_scroll",
      "label": "Show only after scrolling past the add-to-cart button",
      "default": true
    },
    {
      "type": "header",
      "content": "Contents"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show product image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_variants",
      "label": "Show variant selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity selector",
      "default": true
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Add-to-cart label",
      "default": "Add to cart"
    },
    {
      "type": "color",
      "id": "cta_color",
      "label": "Button color",
      "default": "#7c5cff"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "quick_buy",
      "label": "Show quick-buy (skip cart, go to checkout)",
      "default": true
    },
    {
      "type": "text",
      "id": "quick_buy_label",
      "label": "Quick-buy label",
      "default": "Buy it now"
    },
    {
      "type": "header",
      "content": "Free shipping progress bar"
    },
    {
      "type": "checkbox",
      "id": "free_ship",
      "label": "Show free-shipping progress bar",
      "default": true
    },
    {
      "type": "number",
      "id": "free_ship_threshold",
      "label": "Threshold (in your store currency)",
      "default": 75
    },
    {
      "type": "color",
      "id": "free_ship_color",
      "label": "Progress bar color",
      "default": "#34d399"
    },
    {
      "type": "text",
      "id": "free_ship_message",
      "label": "In-progress message (use [remaining] as placeholder)",
      "default": "You're [remaining] away from free shipping!"
    },
    {
      "type": "text",
      "id": "free_ship_success",
      "label": "Unlocked message",
      "default": "You've unlocked free shipping!"
    }
  ]
}
{% endschema %}
