// Klyna Shopify Suite - Prisma schema.
// Session storage plus diagnostic scan history for all five app modes.

generator client {
  provider               = "prisma-client"
  output                 = "../app/generated/prisma-client"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model DiagnosticScan {
  id         String   @id @default(cuid())
  shop       String
  productKey String
  origin     String   @default("manual")
  score      Int
  status     String
  summary    String
  metrics    String
  findings   String
  createdAt  DateTime @default(now())

  @@index([shop, productKey, createdAt])
}

model RedirectInventory {
  id        String   @id @default(cuid())
  shop      String
  paths     String
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
}

model RedirectChange {
  id        String   @id @default(cuid())
  shop      String
  path      String
  target    String
  shopifyId String?
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
}
