{% comment %}
  Klyna Upsell — in-cart upsell widget.

  Reads the merchant's live offers from the app and renders the best match for
  the current cart. Impressions, accepts, and declines are logged back to the
  app so the Analytics dashboard can compute conversion + revenue.

  Add this block to your cart drawer or cart page from the theme editor.
{% endcomment %}

<div
  class="klyna-upsell"
  data-klyna-upsell
  data-app-url="{{ block.settings.app_url | default: 'https://klyna.dev' }}"
  data-shop="{{ shop.permanent_domain }}"
  data-currency="{{ cart.currency.symbol | default: '$' }}"
  data-cart-total="{{ cart.total_price }}"
  data-cart-token="{{ cart.token }}"
  data-placement="cart"
  style="--klyna-accent: {{ block.settings.accent_color }};"
>
  {% comment %} Comma-separated product GIDs currently in the cart. {% endcomment %}
  <script type="application/json" data-klyna-cart>
    {
      "products": [
        {% for item in cart.items %}
          "gid://shopify/Product/{{ item.product_id }}"{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ],
      "collections": [
        {% for item in cart.items %}
          {% for collection in item.product.collections %}
            "gid://shopify/Collection/{{ collection.id }}"{% unless forloop.last %},{% endunless %}
          {% endfor %}{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
  </script>
</div>

{{ 'cart-upsell.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cart-upsell.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Klyna Upsell",
  "target": "section",
  "settings": [
    {
      "type": "url",
      "id": "app_url",
      "label": "App URL",
      "info": "The public URL of your Klyna Upsell app (e.g. https://klyna.dev). Leave default unless self-hosting."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#7c5cff"
    }
  ]
}
{% endschema %}
