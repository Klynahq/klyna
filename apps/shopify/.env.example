# Klyna for Shopify — environment variables.
#
# Copy this file to `.env` and fill in the values you get from your Shopify
# Partner dashboard. Never commit `.env`.

# Shopify Partner credentials (https://partners.shopify.com → Apps → your app → Configuration)
SHOPIFY_API_KEY="REPLACE_ME"
SHOPIFY_API_SECRET="REPLACE_ME"

# The public URL where your dev server is reachable. The Shopify CLI sets this
# automatically when you run `shopify app dev` (it tunnels via Cloudflare).
SHOPIFY_APP_URL="https://klyna.dev"

# Scopes — keep in sync with shopify.app.toml [access_scopes].
SCOPES="read_products,read_content,read_themes,read_orders"

# Postgres session + app storage (Prisma). Use any free tier:
# Neon (neon.tech), Supabase, or Vercel Postgres — no paid plan needed.
#   DATABASE_URL — pooled connection, used by the app at runtime (serverless-safe)
#   DIRECT_URL   — direct (non-pooled) connection, used by `prisma db push` at build
# For Neon: DATABASE_URL is the "-pooler" host, DIRECT_URL is the plain host.
# If your provider has no separate pooler, set both to the same URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
