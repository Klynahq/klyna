// Klyna for Shopify — Prisma schema.
// Backs Shopify session storage and any local state we cache.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model AuditResult {
  id        String   @id @default(cuid())
  shop      String
  url       String
  score     Int
  grade     String
  findings  String   // serialized JSON
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
}

// Per-shop AI provider settings (BYOK — bring your own key).
model AiSettings {
  shop      String   @id
  provider  String   @default("off") // off | openrouter | groq | gemini
  apiKey    String?  // user-supplied; stored only on this shop's DB row
  model     String?
  dailyCap  Int      @default(100)
  updatedAt DateTime @default(now()) @updatedAt
}

// Daily AI usage counter (resets per UTC day) for the per-shop cap.
model AiUsage {
  shop      String
  day       String   // YYYY-MM-DD (UTC)
  count     Int      @default(0)

  @@id([shop, day])
}

// Cache for AI completions (key = FNV hash from @klyna/ai-client).
model AiCache {
  key       String   @id
  value     String
  expiresAt DateTime
}
