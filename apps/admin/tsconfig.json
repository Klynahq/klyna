{
  "extends": "@klyna/tsconfig/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["@remix-run/node", "vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"]
    },
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false,
    "composite": false
  },
  "include": ["app/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "build"]
}
