# Klyna Back-in-Stock — environment variables.
#
# Copy this file to `.env` and fill in the values you get from your Shopify
# Partner dashboard. Never commit `.env`.

# Shopify Partner credentials (https://partners.shopify.com → Apps → your app → Configuration)
SHOPIFY_API_KEY="REPLACE_ME"
SHOPIFY_API_SECRET="REPLACE_ME"

# The public URL where your dev server is reachable. The Shopify CLI sets this
# automatically when you run `shopify app dev` (it tunnels via Cloudflare).
SHOPIFY_APP_URL="https://klyna.dev"

# Scopes — keep in sync with shopify.app.toml [access_scopes].
SCOPES="read_products,read_inventory"

# SQLite session storage + waitlist storage (Prisma).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ── Optional delivery providers ──────────────────────────────────────────────
# Klyna writes every alert to the database regardless. If these are unset, alerts
# are queued + logged (great for dev). Set them in production to actually deliver.

# Email (transactional). Resend is the default; any HTTPS email API works if you
# adapt app/services/notifier.server.ts. Leave blank to run in "log only" mode.
RESEND_API_KEY=""
ALERT_FROM_EMAIL="alerts@klyna.dev"
ALERT_FROM_NAME="Klyna Back-in-Stock"

# SMS (optional). Twilio-style credentials. Leave blank to disable SMS alerts.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
