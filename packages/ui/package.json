{
  "name": "@klyna/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Klyna design tokens (colors, type, spacing). Framework-agnostic.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
